{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/"],
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Listening on",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chrome-flags": ["--no-sandbox", "--disable-dev-shim"]
      }
    },
    "assert": {
      "assertions": {
        "category:accessibility": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-bytes-js": ["error", { "maxNumericValue": 300000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage",
      "reportMarkdown": true
    }
  }
}
